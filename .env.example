# ===========================================
# Traefik Template Environment Configuration
# ===========================================
# Copy this file to .env and update with your values

# Domain Configuration
DOMAIN=example.com
# Subdomain for Traefik dashboard (default: traefik.DOMAIN)
SUBDOMAIN_TRAEFIK=traefik.${DOMAIN}
ACME_EMAIL=admin@example.com

# DNS Provider Configuration (for Let's Encrypt DNS Challenge)
# ClouDNS Example - Replace with your provider
CLOUDNS_SUB_AUTH_ID=your_auth_id
CLOUDNS_AUTH_PASSWORD=your_password

# DNS Resolvers for ACME Challenge
# ClouDNS resolvers (use your provider's DNS servers for better reliability)
# Format: "server1:53,server2:53,server3:53,server4:53"
DNS_RESOLVERS=pns31.cloudns.net:53,pns32.cloudns.net:53,pns33.cloudns.net:53,pns34.cloudns.net:53

# Delay before DNS check (seconds) - useful for slow DNS propagation
# Increase if you get DNS-01 challenge errors
DNS_CHECK_DELAY=30

# Network Configuration
# Using 10.240.x.x range to minimize conflicts with cloud providers, VPNs, and K8s
NETWORK_SUBNET_PUBLIC=10.240.0.0/24
NETWORK_SUBNET_FRONTEND=10.241.0.0/24
NETWORK_SUBNET_BACKEND=10.242.0.0/24
NETWORK_SUBNET_MANAGEMENT=10.243.0.0/24

# Dynamic IP pool (Docker --ip-range) for each network.
# Each /24 is split in two zones:
#   .1        gateway
#   .2-.127   STATIC zone: only containers with an explicit ipv4_address (.2 = Traefik)
#   .128-.254 DYNAMIC pool: what Docker hands out to containers WITHOUT ipv4_address
# Rule: every container on a traefik-* network declares ipv4_address in the static zone.
# The pool is only a safety net - a container that forgets the rule lands in .128+ and
# can never take Traefik's address (see docs/NETWORK_SEGMENTATION.md, "IP allocation").
NETWORK_IPRANGE_PUBLIC=10.240.0.128/25
NETWORK_IPRANGE_FRONTEND=10.241.0.128/25
NETWORK_IPRANGE_BACKEND=10.242.0.128/25
NETWORK_IPRANGE_MANAGEMENT=10.243.0.128/25

# Traefik Configuration
TRAEFIK_DASHBOARD_ENABLED=true

# Logging Configuration
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_LOG_FORMAT=json
# To enable file logging, uncomment filePath in traefik.yml.template
# To enable access logs, uncomment the accessLog section in traefik.yml.template
# TRAEFIK_ACCESS_LOG_FORMAT=json

# Security Configuration
TRAEFIK_BASIC_AUTH_USER=admin
# Generate with: htpasswd -nb admin your_password | sed 's/\$/DOLLAR/g'
# Use DOLLAR instead of $ to avoid shell expansion issues
TRAEFIK_BASIC_AUTH_PASSWORD=DOLLARapr1DOLLARyourDOLLARencryptedDOLLARpassword

# Rate Limiting
RATE_LIMIT_AVERAGE=100
RATE_LIMIT_BURST=50

# Monitoring (Optional)
METRICS_ENABLED=false
METRICS_PORT=8080